---
// A swipeable photo gallery: CSS scroll-snap track, arrow buttons, dots and a
// full-size viewer. No library; the track scrolls natively so touch swipe works.
import { photo } from '../data/photos';

interface Props {
  name: string;
  images: string[];
}

const { name, images } = Astro.props;
const slides = images.map((src) => ({ src, ...photo(src) }));
---

{slides.length > 0 && (
  <section class="gallery" aria-label={`Photos of ${name}`} data-count={slides.length}>
    <div class="track" tabindex="0" role="group" aria-roledescription="carousel">
      {slides.map((s, i) => (
        <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          <button class="open" type="button" data-i={i} aria-label={`View photo ${i + 1} full size`}>
            <img
              src={s.src}
              alt={s.alt}
              width="1200"
              height="800"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
          <figcaption>{s.alt}</figcaption>
        </figure>
      ))}
    </div>

    {slides.length > 1 && (
      <>
        <button class="gnav prev" type="button" aria-label="Previous photo">‹</button>
        <button class="gnav next" type="button" aria-label="Next photo">›</button>
        <div class="dots" aria-hidden="true">
          {slides.map((_, i) => <span class:list={['dot', i === 0 && 'on']}></span>)}
        </div>
      </>
    )}

    <dialog class="viewer" aria-label={`${name} photo viewer`}>
      <button class="close" type="button" aria-label="Close viewer">×</button>
      {slides.length > 1 && <button class="vnav vprev" type="button" aria-label="Previous photo">‹</button>}
      <img class="vimg" alt="" />
      {slides.length > 1 && <button class="vnav vnext" type="button" aria-label="Next photo">›</button>}
      <p class="vcap"></p>
    </dialog>

    <script type="application/json" class="gallery-data" set:html={JSON.stringify(slides.map((s) => ({ src: s.src, alt: s.alt })))} />
  </section>
)}

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.gallery').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
    const data = JSON.parse(root.querySelector('.gallery-data')!.textContent || '[]') as { src: string; alt: string }[];
    const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';
    let current = 0;

    const go = (i: number) => {
      const n = slides.length;
      current = (i + n) % n;
      track.scrollTo({ left: slides[current].offsetLeft - track.offsetLeft, behavior });
    };

    track.addEventListener('scroll', () => {
      const idx = Math.round(track.scrollLeft / (slides[0]?.clientWidth || 1));
      dots.forEach((d, i) => d.classList.toggle('on', i === idx));
      current = idx;
    }, { passive: true });

    root.querySelector('.prev')?.addEventListener('click', () => go(current - 1));
    root.querySelector('.next')?.addEventListener('click', () => go(current + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
    });

    // full-size viewer
    const dlg = root.querySelector<HTMLDialogElement>('.viewer')!;
    const vimg = dlg.querySelector<HTMLImageElement>('.vimg')!;
    const vcap = dlg.querySelector<HTMLElement>('.vcap')!;
    let vi = 0;
    const show = (i: number) => {
      vi = (i + data.length) % data.length;
      vimg.src = data[vi].src;
      vimg.alt = data[vi].alt;
      vcap.textContent = `${vi + 1} / ${data.length} · ${data[vi].alt}`;
    };
    root.querySelectorAll<HTMLButtonElement>('.open').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.i)); dlg.showModal(); })
    );
    dlg.querySelector('.close')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('.vprev')?.addEventListener('click', () => show(vi - 1));
    dlg.querySelector('.vnext')?.addEventListener('click', () => show(vi + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(vi + 1);
      if (e.key === 'ArrowLeft') show(vi - 1);
    });
    let sx = 0;
    vimg.addEventListener('pointerdown', (e) => { sx = e.clientX; });
    vimg.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 40 && data.length > 1) show(vi + (dx < 0 ? 1 : -1));
    });
  });
</script>

<style>
  .gallery { position: relative; margin: 0 0 var(--space-lg); }
  .track {
    display: flex; gap: 0.8rem; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; border-radius: 1rem; outline-offset: 4px;
    -webkit-overflow-scrolling: touch;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; position: relative; border-radius: 1rem; overflow: hidden; background: var(--panel); }
  .open { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; aspect-ratio: 3 / 2; overflow: hidden; }
  .open img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
  .slide:hover .open img { transform: scale(1.04); }
  figcaption {
    position: absolute; inset: auto 0 0 0; padding: 2rem 1rem 0.7rem;
    font-size: var(--text-xs); color: #fff; pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.7));
  }
  .gnav {
    position: absolute; top: 50%; translate: 0 -50%; z-index: 2;
    width: var(--tap); height: var(--tap); border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35); background: rgba(0, 0, 0, 0.5); color: #fff;
    font-size: 1.6rem; line-height: 1; cursor: pointer; backdrop-filter: blur(4px);
  }
  .gnav:hover { background: rgba(0, 0, 0, 0.75); }
  .prev { left: 0.6rem; }
  .next { right: 0.6rem; }
  .dots { position: absolute; top: 0.8rem; right: 0.9rem; display: flex; gap: 0.35rem; z-index: 2; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: rgba(255, 255, 255, 0.5); transition: background 0.25s ease, transform 0.25s ease; }
  .dot.on { background: #fff; transform: scale(1.3); }

  .viewer {
    border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh;
    color: #fff; align-content: center; justify-items: center;
  }
  .viewer[open] { display: grid; }
  .viewer::backdrop { background: rgba(0, 0, 0, 0.92); }
  .vimg { max-width: min(96vw, 1400px); max-height: 80dvh; object-fit: contain; border-radius: 0.5rem; }
  .vcap { margin-top: 0.8rem; font-size: var(--text-sm); color: #ddd; text-align: center; max-width: 60ch; padding-inline: 1rem; }
  .close, .vnav {
    position: absolute; width: var(--tap); height: var(--tap); border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.4); background: rgba(255, 255, 255, 0.1); color: #fff; font-size: 1.6rem; line-height: 1;
  }
  .close { top: 1rem; right: 1rem; }
  .vnav { top: 50%; translate: 0 -50%; }
  .vprev { left: 0.8rem; }
  .vnext { right: 0.8rem; }

  @media (prefers-reduced-motion: reduce) {
    .open img, .dot { transition: none; }
    .slide:hover .open img { transform: none; }
  }
  @media (min-width: 50rem) {
    .slide { flex-basis: 78%; }
  }
</style>
