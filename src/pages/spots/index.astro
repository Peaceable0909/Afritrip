---
import Cinematic from '../../layouts/Cinematic.astro';
import SpotCard from '../../components/SpotCard.astro';
import { spots, categoryLabels, stateLabels, type Category, type StateSlug } from '../../data/spots';

const categories = Object.keys(categoryLabels) as Category[];
const usedStates = (Object.keys(stateLabels) as StateSlug[]).filter((st) => spots.some((s) => s.state === st));
---

<Cinematic title="All spots — Waka" description="Every Waka spot: real prices, honest safety notes, curated by people wey sabi road.">
  <section class="listing">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>›</span> <b>Spots</b>
    </nav>

    <div class="head">
      <p class="script kicker">Spots wey sure</p>
      <h1>Every spot, one honest list</h1>
      <p class="sub">
        {spots.length} places across {usedStates.length} states — each with the price locals pay and a
        straight-talk safety note for day and night.
      </p>
    </div>

    <div class="chip-row" role="group" aria-label="Filter by state">
      <button class="chip" data-state="all" aria-pressed="true">All states</button>
      {usedStates.map((st) => (
        <button class="chip" data-state={st} aria-pressed="false">{stateLabels[st]}</button>
      ))}
    </div>

    <div class="chip-row" role="group" aria-label="Filter by category">
      <button class="chip" data-cat="all" aria-pressed="true">All</button>
      {categories.map((cat) => (
        <button class="chip" data-cat={cat} aria-pressed="false">
          {categoryLabels[cat]}
        </button>
      ))}
    </div>

    <div class="spot-grid" id="spot-grid">
      {spots.map((spot) => <SpotCard spot={spot} />)}
    </div>
  </section>
</Cinematic>

<script>
  const catChips = document.querySelectorAll<HTMLButtonElement>('.chip[data-cat]');
  const stateChips = document.querySelectorAll<HTMLButtonElement>('.chip[data-state]');
  const cards = document.querySelectorAll<HTMLElement>('.spot-card');
  let cat = 'all';
  let state = 'all';

  function apply() {
    catChips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === cat)));
    stateChips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.state === state)));
    cards.forEach((card) => {
      const ok =
        (cat === 'all' || card.dataset.category === cat) &&
        (state === 'all' || card.dataset.state === state);
      card.style.display = ok ? '' : 'none';
    });
  }

  function sync(key: string, value: string) {
    const url = new URL(window.location.href);
    if (value === 'all') url.searchParams.delete(key);
    else url.searchParams.set(key, value);
    history.replaceState(null, '', url);
  }

  catChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      cat = chip.dataset.cat ?? 'all';
      apply();
      sync('cat', cat);
    })
  );
  stateChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      state = chip.dataset.state ?? 'all';
      apply();
      sync('state', state);
    })
  );

  const params = new URLSearchParams(window.location.search);
  const initialCat = params.get('cat');
  const initialState = params.get('state');
  if (initialCat && [...catChips].some((c) => c.dataset.cat === initialCat)) cat = initialCat;
  if (initialState && [...stateChips].some((c) => c.dataset.state === initialState)) state = initialState;
  apply();
</script>

<style>
  .listing { padding: 6.5rem clamp(1rem, 4vw, 3rem) 4.5rem; }
  .crumbs {
    font-size: 0.82rem; color: var(--text-dim);
    display: flex; gap: 0.5rem; align-items: center; margin-bottom: 2rem;
  }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--text); }
  .crumbs b { color: var(--green); font-weight: 600; }

  .head { margin-bottom: 2rem; }
  .kicker { font-size: clamp(1.4rem, 3.5vw, 2rem); color: var(--green); }
  h1 { font-family: var(--font-display); font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; margin-top: 0.3rem; }
  .sub { margin-top: 0.8rem; color: var(--text-dim); max-width: 52ch; }

  .chip-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
  .chip {
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.5rem 1.1rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--panel); color: var(--text);
    cursor: pointer;
    min-height: 44px; min-width: 44px;
  }
  .chip:hover { border-color: var(--green); }
  .chip[aria-pressed='true'] {
    background: var(--green); color: var(--on-accent); border-color: var(--edge);
    box-shadow: 2px 2px 0 var(--edge);
  }

  .spot-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 1.25rem;
  }
</style>
