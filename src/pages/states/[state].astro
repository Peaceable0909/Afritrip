---
import Cinematic from '../../layouts/Cinematic.astro';
import { states } from '../../data/states';
import { photoAlt } from '../../data/photos';

export function getStaticPaths() {
  return states.map((s) => ({ params: { state: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const isLagos = s.slug === 'lagos';
const hasNightlife = s.slug === 'lagos' || s.slug === 'abuja';

const reelPhotos = [s.heroImg, ...s.highlights.slice(0, 3).map((h) => h.img)];

const rail = [
  { name: 'Beaches', img: '/img/photos/cat-beaches.jpg', href: '/spots/?cat=beach' },
  { name: 'Nightlife', img: '/img/photos/cat-nightlife.jpg', href: hasNightlife ? `/nightlife/?city=${s.slug}` : '/spots/?cat=nightlife' },
  { name: 'Restaurants', img: '/img/photos/cat-food.jpg', href: '/spots/?cat=food' },
  { name: 'Hotels', img: '/img/photos/cat-hotels.jpg', href: '/spots/' },
  { name: 'Events', img: '/img/photos/cat-events.jpg', href: '/spots/' },
  { name: 'Adventures', img: '/img/photos/cat-adventures.jpg', href: '/spots/?cat=nature' },
];
---

<Cinematic title={`${s.name} — Waka`} description={s.tagline} hero>
  <section class="hero">
    <img class="hero-bg" src={s.heroImg} alt={photoAlt(s.heroImg, s.name)} width="1920" height="1080" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>

    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>›</span> <a href="/#explore">States</a> <span>›</span> <b>{s.name}</b>
    </nav>

    <div class="hero-content">
      <p class="script welcome">Welcome to</p>
      <h1 class="script" id="state-name" data-name={s.scriptName} data-alt={s.altName}>{s.scriptName}</h1>
      <div class="brush" aria-hidden="true"></div>
      <p class="lede">{s.tagline}</p>
      <div class="chips">
        {s.chips.map((c) => (
          <div class="chip"><b>{c.value}</b><span>{c.label}</span></div>
        ))}
      </div>
    </div>

    <aside class="side-nav" aria-label="Sections">
      <a href="#map">Map</a>
      <a href="#experiences">Spots</a>
      {hasNightlife && <a href={`/nightlife/?city=${s.slug}`}>Nightlife</a>}
      {isLagos && <a href="/spots/?cat=beach">Beaches</a>}
      {isLagos && <a href="/spots/">All</a>}
    </aside>
  </section>

  {isLagos && (
    <section class="rail-wrap">
      <div class="rail">
        {rail.map((r) => (
          <a class="rail-card" href={r.href}>
            <img src={r.img} alt={photoAlt(r.img, r.name)} width="640" height="640" loading="lazy" decoding="async" />
            <span>{r.name}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="map-row" id="map">
    <div class="map-card">
      <p class="script map-title">Explore {s.name}</p>
      <iframe
        class="map-frame"
        title={`Map of ${s.name}`}
        src={`https://www.google.com/maps?q=${encodeURIComponent(s.map.query)}&ll=${s.map.ll}&z=${s.map.zoom}&output=embed`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <ul class="areas" aria-label={`Areas of ${s.name}`}>
        {s.mapLabels.map((l) => (
          <li>
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${l.name} ${s.name}`)}`} target="_blank" rel="noopener noreferrer">{l.name} ↗</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="map-side">
      <div class="know">
        <h2>Did you know?</h2>
        <p>{s.fact}</p>
        {isLagos ? (
          <a href="/spots/">See the spots →</a>
        ) : (
          <a href="/states/lagos/">Start with Lagos →</a>
        )}
      </div>
      <a class="reel" href={`/spots/?state=${s.slug}`} aria-label={`See the spots in ${s.name}`}>
        {reelPhotos.map((src, i) => (
          <img src={src} alt={i === 0 ? photoAlt(src, s.name) : ''} style={`animation-delay:${i * 5}s`} width="1280" height="720" loading="lazy" decoding="async" />
        ))}
        <span class="reel-label">See the spots in {s.name} →</span>
      </a>
    </div>
  </section>

  <section class="exps" id="experiences">
    <div class="exps-head">
      <h2 class="script">Top Experiences in {s.name}</h2>
      <a href={`/spots/?state=${s.slug}`}>View all →</a>
    </div>
    <div class={`exp-row ${s.highlights.length <= 3 ? 'wide' : ''}`}>
      {s.highlights.map((e) =>
        e.href ? (
          <a class="exp-card" href={e.href}>
            <img src={e.img} alt={photoAlt(e.img, e.name)} width="800" height="600" loading="lazy" decoding="async" />
            <span>{e.name}</span>
          </a>
        ) : (
          <div class="exp-card">
            <img src={e.img} alt={photoAlt(e.img, e.name)} width="800" height="600" loading="lazy" decoding="async" />
            <span>{e.name}</span>
          </div>
        )
      )}
    </div>
    <p class="doodle script" aria-hidden="true">{s.doodle[0]}<br />{s.doodle[1]}<br />{s.doodle[2]}</p>
  </section>

  <style>
    .hero { position: relative; min-height: 92vh; min-height: 92dvh; display: grid; align-content: center; overflow: hidden; color: var(--on-photo); }
    .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: drift 26s ease-in-out infinite alternate; }
    @keyframes drift { from { transform: scale(1); } to { transform: scale(1.08) translateX(-1.5%); } }
    .hero-shade {
      position: absolute; inset: 0;
      background:
        linear-gradient(90deg, rgba(var(--scrim-rgb), 0.82) 0%, rgba(var(--scrim-rgb), 0.35) 50%, rgba(var(--scrim-rgb), 0.12) 75%),
        linear-gradient(180deg, rgba(var(--scrim-rgb), 0.5) 0%, rgba(var(--scrim-rgb), 0) 25%, rgba(var(--scrim-rgb), 0.8) 100%);
    }
    .crumbs {
      position: absolute; top: 4.6rem; left: clamp(1.25rem, 5vw, 4rem);
      font-size: 0.82rem; color: rgba(255,255,255,0.85); display: flex; gap: 0.5rem; align-items: center;
      text-shadow: 0 1px 6px rgba(0,0,0,0.8); z-index: 2;
    }
    .crumbs a { text-decoration: none; }
    .crumbs a:hover { color: #fff; }
    .crumbs b { color: var(--sun); font-weight: 600; }

    .hero-content { position: relative; padding: 7rem clamp(1.25rem, 5vw, 4rem) 4rem; max-width: 46rem; }
    .welcome { font-size: clamp(1.4rem, 3.5vw, 2rem); color: var(--sun); text-shadow: 0 2px 14px rgba(0,0,0,0.7); }
    .hero h1 {
      font-size: clamp(4rem, 13vw, 8.5rem); font-weight: 400; color: #fff; line-height: 1;
      text-shadow: 0 6px 30px rgba(0,0,0,0.6); transform: rotate(-3deg); width: max-content; max-width: 100%;
    }
    .brush { width: clamp(10rem, 24vw, 16rem); height: 0.55rem; background: var(--neon-pink); border-radius: 999px; transform: rotate(-3deg) translateY(-0.4rem); box-shadow: 0 0 18px rgba(255,61,143,0.6); }
    .lede { margin-top: 1.4rem; max-width: 38ch; text-shadow: 0 1px 10px rgba(0,0,0,0.8); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; }
    .chip {
      display: grid; gap: 0; padding: 0.55rem 1rem; border-radius: 0.7rem;
      background: var(--glass); border: 1px solid var(--line); backdrop-filter: blur(6px); color: var(--text);
    }
    .chip b { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); }
    .chip span { font-size: 0.68rem; color: var(--text-dim); }

    .side-nav {
      position: absolute; right: 1.2rem; top: 50%; transform: translateY(-50%);
      display: grid; gap: 0.5rem; z-index: 2;
    }
    .side-nav a {
      font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; text-align: center;
      background: var(--glass); color: var(--text); border: 1px solid var(--line); border-radius: 0.6rem;
      padding: 0.55rem 0.7rem; min-height: 44px; min-width: 44px; display: grid; place-content: center; backdrop-filter: blur(6px);
    }
    .side-nav a:hover { border-color: var(--accent); color: var(--accent); }

    .rail-wrap { padding: 2.2rem clamp(1rem, 4vw, 3rem) 0.5rem; }
    .rail { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.9rem; }
    .rail-card {
      position: relative; aspect-ratio: 1; border-radius: 0.8rem; overflow: hidden;
      border: 1px solid var(--line); text-decoration: none; transition: transform 0.18s ease;
    }
    .rail-card img { width: 100%; height: 100%; object-fit: cover; }
    .rail-card span {
      position: absolute; inset: auto 0 0 0; padding: 1.6rem 0.7rem 0.6rem; font-size: 0.85rem; font-weight: 600; color: var(--on-photo);
      background: linear-gradient(180deg, transparent, rgba(0,0,0,0.85));
    }
    .rail-card:hover { transform: translateY(-4px); border-color: var(--accent); }

    .map-row {
      display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 1.2rem;
      padding: 2.5rem clamp(1rem, 4vw, 3rem);
    }
    .map-card { display: grid; gap: 0.8rem; align-content: start; }
    .map-title { font-size: clamp(1.8rem, 4vw, 2.6rem); color: var(--text); line-height: 1.1; }
    .map-frame { width: 100%; height: clamp(16rem, 38vw, 26rem); border: 1px solid var(--line); border-radius: 1rem; background: var(--panel); }
    .areas { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
    .areas a {
      display: inline-flex; align-items: center; min-height: var(--tap); padding: 0.3rem 0.9rem; border-radius: 999px;
      border: 1px solid var(--line); background: var(--panel); color: var(--text); text-decoration: none;
      font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    }
    .areas a:hover { border-color: var(--accent); color: var(--accent); }
    .map-side { display: grid; gap: 1.2rem; align-content: start; }
    .know { background: var(--panel); border: 1px solid var(--line); border-radius: 1rem; padding: 1.5rem; }
    .know h2 { font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 0.6rem; }
    .know p { font-size: 0.9rem; color: var(--text-dim); }
    .know a { display: inline-block; margin-top: 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--accent); text-decoration: none; }
    .know a:hover { text-decoration: underline; }
    .reel { position: relative; border-radius: 1rem; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 16/9; text-decoration: none; color: var(--on-photo); background: var(--panel); }
    /* four photographs cross-fade in turn, each with a slow push-in */
    .reel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: reel 20s ease-in-out infinite; }
    @keyframes reel {
      0% { opacity: 0; transform: scale(1); }
      6% { opacity: 1; }
      25% { opacity: 1; }
      31% { opacity: 0; transform: scale(1.08); }
      100% { opacity: 0; transform: scale(1.08); }
    }
    .reel::after { content: ''; position: absolute; inset: 45% 0 0 0; background: linear-gradient(180deg, transparent, rgba(0,0,0,0.75)); }
    .reel-label { position: absolute; z-index: 1; bottom: 0.8rem; left: 1rem; font-weight: 600; font-size: 0.9rem; text-shadow: 0 1px 8px rgba(0,0,0,0.9); }
    .reel:hover .reel-label { text-decoration: underline; text-underline-offset: 4px; }

    .exps { padding: 1.5rem clamp(1rem, 4vw, 3rem) 4rem; position: relative; }
    .exps-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
    .exps-head h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 400; }
    .exps-head a { font-size: 0.85rem; color: var(--text-dim); text-decoration: none; }
    .exps-head a:hover { color: var(--accent); }
    .exp-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.9rem; }
    .exp-row.wide { grid-template-columns: repeat(3, 1fr); }
    .exp-card {
      position: relative; aspect-ratio: 4/5; border-radius: 0.8rem; overflow: hidden;
      border: 1px solid var(--line); text-decoration: none; transition: transform 0.18s ease;
    }
    .exp-row.wide .exp-card { aspect-ratio: 4/3; }
    .exp-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
    a.exp-card:hover img, a.exp-card:focus-visible img { transform: scale(1.07); }
    .rail-card img { transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .rail-card:hover img { transform: scale(1.07); }
    .exp-card span {
      position: absolute; inset: auto 0 0 0; padding: 1.8rem 0.8rem 0.7rem; font-size: 0.82rem; font-weight: 600; color: var(--on-photo);
      background: linear-gradient(180deg, transparent, rgba(0,0,0,0.88));
    }
    a.exp-card:hover { transform: translateY(-4px); border-color: var(--accent); }
    .doodle {
      position: absolute; right: clamp(1rem, 4vw, 3rem); bottom: -1.2rem;
      font-size: 1.9rem; line-height: 1.05; text-align: center; transform: rotate(-8deg);
      color: var(--neon-pink);
      pointer-events: none;
    }
    .doodle::after { content: '♥'; display: block; color: var(--neon-green); font-size: 1.1rem; }

    @media (prefers-reduced-motion: reduce) {
      .hero-bg { animation: none; }
      .reel img { animation: none; }
      .reel img:first-child { opacity: 1; }
      .exp-card img, .rail-card img { transition: none; }
      a.exp-card:hover img, .rail-card:hover img { transform: none; }
    }
    @media (max-width: 56rem) {
      .side-nav { display: none; }
      .rail { grid-template-columns: repeat(3, 1fr); }
      .map-row { grid-template-columns: 1fr; }
      .exp-row, .exp-row.wide { grid-template-columns: repeat(2, 1fr); }
      .exp-row .exp-card:last-child { grid-column: span 2; aspect-ratio: 16/9; }
      .doodle { display: none; }
    }
  </style>
</Cinematic>

<script>
  import { gsap } from 'gsap';

  // Text Morph: the state's name breathes between English and its local name
  const el = document.getElementById('state-name');
  const alt = el?.dataset.alt;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && alt && !reduced) {
    const names = [el.dataset.name!, alt];
    let which = 0;

    const renderChars = (text: string) => {
      el.innerHTML = '';
      [...text].forEach((ch) => {
        const span = document.createElement('span');
        span.textContent = ch === ' ' ? ' ' : ch;
        span.style.display = 'inline-block';
        el.appendChild(span);
      });
      return el.children;
    };

    renderChars(names[0]);

    setInterval(() => {
      const out = [...el.children];
      gsap.to(out, {
        y: -22,
        opacity: 0,
        stagger: 0.035,
        duration: 0.38,
        ease: 'power2.in',
        onComplete: () => {
          which = 1 - which;
          const chars = renderChars(names[which]);
          gsap.fromTo(chars, { y: 22, opacity: 0 }, { y: 0, opacity: 1, stagger: 0.045, duration: 0.45, ease: 'back.out(1.7)' });
        },
      });
    }, 5000);
  }
</script>
